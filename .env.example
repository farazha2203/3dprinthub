DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=3dprinthub.ir,www.3dprinthub.ir,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://3dprinthub.ir,https://www.3dprinthub.ir
DB_ENGINE=django.db.backends.mysql
DB_NAME=replace_database_name
DB_USER=replace_database_user
DB_PASSWORD=replace_database_password
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60
STATIC_ROOT=/home/sfkilvrs/public_html/static
MEDIA_ROOT=/home/sfkilvrs/public_html/media

# Google OAuth (Django allauth)
# Production redirect URI: https://3dprinthub.ir/accounts/google/login/callback/
# Local redirect URI: http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DJANGO_SITE_ID=1
ACCOUNT_EMAIL_VERIFICATION=none

# Transactional email / password recovery
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=3DPrintHub <no-reply@3dprinthub.ir>
PASSWORD_RESET_TIMEOUT=3600

# Phase49.3B Catalog Center AI providers.
# Prefer the Windows keyring/UI cards for real secrets; these environment names
# are optional deployment/diagnostic fallbacks and must never be committed with values.
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
AVALAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=
