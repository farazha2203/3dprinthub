[Unit]
Description=3DPrintHub Link Analysis Worker
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/3dprinthub
EnvironmentFile=/var/www/3dprinthub/.env
ExecStart=/var/www/3dprinthub/.venv/bin/python manage.py process_link_analysis_queue --watch
Restart=always
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/www/3dprinthub/media /var/www/3dprinthub/logs

[Install]
WantedBy=multi-user.target
