# 3DPrintHub Catalog Center - persistent local settings
# This file is safe to commit because it contains NO real secrets.
# Copy values into .env in the same folder. Never commit the real .env.

# AI
CATALOG_AI_PROVIDER="auto"
CATALOG_AI_MODEL=""
AVALAI_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# Site / FTP / Bridge
CATALOG_FTP_HOST="ftp.3dprinthub.ir"
CATALOG_FTP_PORT="21"
CATALOG_FTP_USER=""
CATALOG_FTP_PASSWORD=""
CATALOG_FTP_REMOTE_ROOT="/3dprinthub"
CATALOG_SITE_URL="https://3dprinthub.ir"
CATALOG_BRIDGE_TOKEN=""

# Local paths / diagnostics
CATALOG_HOST_MIRROR="D:\\projects\\3dprinthub-houst"
CATALOG_DEBUG="0"
