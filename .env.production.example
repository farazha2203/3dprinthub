# Django core
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=3dprinthub.ir,www.3dprinthub.ir
DJANGO_CSRF_TRUSTED_ORIGINS=https://3dprinthub.ir,https://www.3dprinthub.ir
DJANGO_SITE_ID=1
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
USE_X_FORWARDED_PROTO=1

# Database
DB_ENGINE=django.db.backends.mysql
DB_NAME=3dprinthub
DB_USER=3dprinthub
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Static, public media and private customer files
STATIC_ROOT=/var/www/3dprinthub/staticfiles
MEDIA_ROOT=/var/www/3dprinthub/media
PRIVATE_MEDIA_ROOT=/var/lib/3dprinthub/private_media

# Google login
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ACCOUNT_EMAIL_VERIFICATION=optional

# Transactional email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=3DPrintHub <no-reply@3dprinthub.ir>
SERVER_EMAIL=3DPrintHub Server <server@3dprinthub.ir>

# Realtime and workers
REALTIME_REDIS_URL=redis://127.0.0.1:6379/1
REALTIME_POLL_FALLBACK_SECONDS=5
REALTIME_REDIS_AUTO_FALLBACK=0
REALTIME_ALLOW_POLLING_ONLY=0
LINK_WORKER_HEALTH_TOKEN=replace-with-at-least-24-random-characters

# Phase 28 commerce settings are stored in Django admin / SiteSetting:
# WhatsApp, Telegram, payment card number, card holder and default deposit percent.
# Verify them with: python manage.py phase28_conversion_audit --strict

# Phase 29 operator quote alerts
SITE_BASE_URL=https://3dprinthub.ir
TELEGRAM_OPERATOR_BOT_TOKEN=
TELEGRAM_OPERATOR_CHAT_ID=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OPERATOR_PHONE=
WHATSAPP_GRAPH_API_VERSION=
# For reliable business-initiated WhatsApp alerts, configure an approved template.
WHATSAPP_OPERATOR_TEMPLATE_NAME=
WHATSAPP_OPERATOR_TEMPLATE_LANGUAGE=fa
OPERATOR_ALERT_EMAILS=

# Phase 30 - online payment gateway
PAYMENT_GATEWAY_ENABLED=0
PAYMENT_GATEWAY_PROVIDER=zarinpal
PAYMENT_GATEWAY_HTTP_TIMEOUT=15
PAYMENT_GATEWAY_PENDING_TTL_MINUTES=30
PAYMENT_GATEWAY_VERIFY_LOCK_SECONDS=60
PAYMENT_GATEWAY_DESCRIPTION_PREFIX=3DPrintHub

# Keep secrets only in .env on the server; never commit real values.
ZARINPAL_MERCHANT_ID=
ZARINPAL_ACCESS_TOKEN=
ZARINPAL_SANDBOX=0
ZARINPAL_CURRENCY=IRT
ZARINPAL_REQUEST_URL=https://api.zarinpal.com/pg/v4/payment/request.json
ZARINPAL_VERIFY_URL=https://api.zarinpal.com/pg/v4/payment/verify.json
ZARINPAL_START_URL=https://www.zarinpal.com/pg/StartPay/
ZARINPAL_SANDBOX_REQUEST_URL=https://sandbox.zarinpal.com/pg/v4/payment/request.json
ZARINPAL_SANDBOX_VERIFY_URL=https://sandbox.zarinpal.com/pg/v4/payment/verify.json
ZARINPAL_SANDBOX_START_URL=https://sandbox.zarinpal.com/pg/StartPay/
